
.claude/settings.local.json

# Personal, machine-specific symlink to a local skills collection; must not be
# committed (breaks on other checkouts / CI — see claude-code-action ENOENT).
.claude/skills

# Keep local agent artifacts ignored; publish only the portable skill baseline.
!/.agents/
.agents/*
!.agents/skills/
.agents/skills/*
