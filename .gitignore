
.claude/settings.local.json

# Personal, machine-specific symlink to a local skills collection; must not be
# committed (breaks on other checkouts / CI — see claude-code-action ENOENT).
.claude/skills

# Local agent / issue-workflow artifacts are per-machine helpers, not supported
# repo tooling; keep them untracked.
.agents/
create-issues.sh
update-issue-rules.sh

# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# Per-machine services, private TLS, generated docs, workspaces and temporary operations.
/runtime/

# typescript
*.tsbuildinfo

# prisma / local db
*.db
*.db-journal
/prisma/*.db
/prisma/migrations/dev.db*

# env
.env
.env.local
.env*.local
config/*.local.json
/.setup-instance-*/

# logs
*.log
npm-debug.log*

# os / editor
.DS_Store

# Local dev-server launch config (per-machine)
.claude/launch.json
