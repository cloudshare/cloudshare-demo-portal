{
  "name": "cloudshare-demo-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:docs": "node scripts/build-docs-site.mjs",
    "test:docs": "node --test scripts/build-docs-site.test.mjs",
    "start": "next start",
    "setup:instance": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/setup-instance.mjs",
    "backup:instance": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/instance-backup.mjs",
    "test:instance-backup": "node --test scripts/instance-backup.test.mjs",
    "test:instance-launchers": "node --test --test-reporter=tap scripts/instance-launchers.test.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:launcher && vitest run",
    "test:e2e:live": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "qa:seed-cohort-rate-limit": "node scripts/seed-local-cohort-rate-limit-qa.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "dev:tunnel": "node scripts/dev-with-tunnel.mjs",
    "test:launcher": "node --test scripts/dev-with-tunnel.test.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "next": "^15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "windows-iana": "5.1.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "jsdom": "^29.1.1",
    "markdown-it": "15.0.3",
    "prisma": "^6.1.0",
    "typescript": "^5.7.2",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.25.12": true,
    "prisma@6.19.3": true,
    "sharp@0.35.5": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "next": {
      "postcss": "8.5.23"
    }
  }
}
