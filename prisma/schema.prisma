// CloudShare Demo Portal — persistence schema.
// SQLite for the demo; provider is swappable to PostgreSQL for the cloud future.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Walking-skeleton tracer entity: proves the persistence seam round-trips.
// Real domain entities (Candidate, ExamAttempt, ...) arrive in later slices.
model Heartbeat {
  id        String   @id @default(cuid())
  source    String
  createdAt DateTime @default(now())
}

model Customer {
  id                   String                @id @default(cuid())
  slug                 String                @unique
  name                 String
  workspace            String                @default("certification")
  createdAt            DateTime              @default(now())
  users                User[]
  exams                Exam[]
  demoItems            DemoItem[]
  examAttempts         ExamAttempt[]
  cloudShareConnection CloudShareConnection?
  salesAccounts        SalesAccount[]
  salesOpportunities   SalesOpportunity[]
  opportunityContacts  OpportunityContact[]
}

model SalesAccount {
  id         String   @id
  customerId String
  name       String
  kind       String
  archivedAt DateTime?
  createdAt  DateTime
  updatedAt  DateTime
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunities SalesOpportunity[]

  @@index([customerId, updatedAt])
  @@unique([customerId, id])
}

model SalesOpportunity {
  id         String   @id
  customerId String
  accountId  String
  name       String
  status     String
  archivedAt DateTime?
  createdAt  DateTime
  updatedAt  DateTime
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  account    SalesAccount @relation(fields: [customerId, accountId], references: [customerId, id], onDelete: Restrict)
  contacts   OpportunityContact[]

  @@index([customerId, accountId, updatedAt])
  @@unique([customerId, id])
}

model OpportunityContact {
  id            String   @id
  customerId    String
  opportunityId String
  firstName     String
  lastName      String
  email         String
  archivedAt    DateTime?
  createdAt     DateTime
  updatedAt     DateTime
  customer      Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunity   SalesOpportunity @relation(fields: [customerId, opportunityId], references: [customerId, id], onDelete: Restrict)

  @@index([customerId, opportunityId, updatedAt])
}

// A Sales-owned, archive-only reusable CloudShare delivery template.  Resource
// identifiers are selected from live per-Customer reads and are never a manual
// authoring field.
model DemoItem {
  id                     String   @id
  customerId             String
  name                   String
  description            String
  projectId              String
  projectName            String
  blueprintsJson         String
  policyId               String
  policyName             String
  regionId               String
  regionName             String
  salesExperienceType    String
  defaultDurationMinutes Int
  status                 String
  archivedAt             DateTime?
  createdAt              DateTime
  updatedAt              DateTime
  customer               Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, status])
}

model User {
  id           String          @id @default(cuid())
  customerId   String
  email        String          @unique
  firstName    String?
  lastName     String?
  passwordHash String
  role         String
  createdAt    DateTime        @default(now())
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessions     PortalSession[]
}

model PortalSession {
  id        String   @id
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CloudShareConnection {
  id                      String    @id @default(cuid())
  customerId              String    @unique
  apiIdCiphertext         String
  apiKeyCiphertext        String
  webhookSecretCiphertext String
  webhookPathToken        String    @unique
  connectedAt             DateTime  @default(now())
  verifiedAt              DateTime?
  updatedAt               DateTime  @updatedAt
  customer                Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Exam {
  id                    String   @id
  customerId            String
  title                 String
  description           String
  timeLimitMinutes      Int
  storageLeaseMinutes   Int?
  openPeriodMinutes     Int
  scoreRetrievalEnabled Boolean
  status                String
  publishedAt           DateTime?
  archivedAt            DateTime?
  createdAt             DateTime
  updatedAt             DateTime
  projectId             String
  projectName           String
  blueprintId           String
  blueprintName         String
  snapshotId            String
  snapshotName          String
  allowedRegionsJson    String
  policyId              String
  policyName            String
  instructorId          String
  instructorName        String
  customer              Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  attempts              ExamAttempt[]
  deliveryAvailability  String   @default("individual")
  cohortSessions        CohortExamSession[]

  @@index([customerId, status])
}

model CohortExamSession {
  id                 String   @id
  customerId         String
  examId             String
  name               String
  admissionStartsAt  DateTime
  admissionEndsAt    DateTime?
  capacity           Int?
  status             String
  cloudShareTrainingId  String?
  cloudShareExperienceId String?
  cloudShareTeamId      String?
  publishedAt        DateTime?
  admissionClosedAt  DateTime?
  retiredAt          DateTime?
  lastPublishError   String?
  lastPublishCorrelationId String?
  createdAt          DateTime
  updatedAt          DateTime
  exam               Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([customerId, examId, status])
  @@index([examId, createdAt])
  @@index([cloudShareTrainingId])
}

model CohortMonitoringObservation {
  id              String   @id @default(cuid())
  customerId      String
  cohortSessionId String
  rowKey          String
  signature       String
  consecutiveReads Int      @default(1)
  observedAt      DateTime

  @@unique([customerId, cohortSessionId, rowKey])
  @@index([cohortSessionId, observedAt])
}

model ExamAttempt {
  id          String     @id
  customerId  String
  candidateId String
  examId      String
  cohortSessionId String?
  status      String
  scheduledFor DateTime?
  createdAt   DateTime
  updatedAt   DateTime   @updatedAt
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  exam        Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  labLaunch   LabLaunch?
  examClock   ExamClock?

  @@index([candidateId, createdAt])
  @@index([examId, createdAt])
  @@index([customerId, candidateId])
  @@index([cohortSessionId, createdAt])
  @@unique([candidateId, cohortSessionId])
}

model ExamAttemptAdmissionLock {
  id          String   @id @default(cuid())
  candidateId String
  examId      String
  acquiredAt  DateTime @default(now())

  @@unique([candidateId, examId])
}

model LabLaunch {
  id                    String      @id
  examAttemptId         String      @unique
  candidateId           String
  participantEmail      String?
  participantId         String?
  trainingId            String?
  experienceId          String
  environmentExternalId String?
  environmentId         String?
  loginUrl              String
  status                String
  createdAt             DateTime
  updatedAt             DateTime    @updatedAt
  examAttempt           ExamAttempt @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt])
  @@index([trainingId])
  @@index([environmentExternalId])
}

model ExamClock {
  examAttemptId     String      @id
  status            String
  elapsedAtPauseMs  Int
  startedAt         DateTime?
  updatedAt         DateTime
  examAttempt       ExamAttempt @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
}

model EnvironmentRecord {
  environmentExternalId String   @id
  status                String
  observedAt            DateTime
}

// Typed, append-only support source of truth (ADR-004). Core correlation fields
// are first-class columns so the Support read API filters on them directly and
// never depends on brittle JSON-string search; only free-form structures are
// JSON-encoded. Rows are append-only evidence — no update path is exposed.
model DiagnosticLogEntry {
  id              String   @id @default(cuid())
  occurredAt      DateTime
  level           String
  source          String
  operation       String
  outcome         String
  customerId      String?
  actorType       String?
  actorId         String?
  actorEmail      String?
  subjectType     String?
  subjectId       String?
  message         String
  correlationId   String?
  candidateEmail  String?
  examId          String?
  examAttemptId   String?
  externalIdsJson String?
  requestJson     String?
  responseJson    String?
  detailsJson     String?
  createdAt       DateTime @default(now())

  @@index([customerId, occurredAt])
  @@index([examAttemptId])
  @@index([candidateEmail])
  @@index([correlationId])
}

// Append-only administrative audit trail. Audit answers who attempted to change
// portal state, what subject was affected, and whether the action succeeded,
// failed, or was denied. It is intentionally separate from DiagnosticLogEntry.
model AuditTrailEntry {
  id             String   @id
  occurredAt     DateTime
  customerId     String?
  actorType      String?
  actorId        String?
  actorEmail     String?
  action         String
  subjectType    String?
  subjectId      String?
  outcome        String
  candidateId    String?
  candidateEmail String?
  examId         String?
  examAttemptId  String?
  correlationId  String?
  detailsJson    String?
  error          String?
  createdAt      DateTime @default(now())

  @@index([customerId, occurredAt])
  @@index([examAttemptId])
  @@index([examId])
  @@index([candidateEmail])
  @@index([actorEmail])
  @@index([subjectType, subjectId])
  @@index([correlationId])
}
