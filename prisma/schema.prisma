// CloudShare Demo Portal — persistence schema.
// SQLite for the demo; provider is swappable to PostgreSQL for the cloud future.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Walking-skeleton tracer entity: proves the persistence seam round-trips.
// Real domain entities (Candidate, ExamAttempt, ...) arrive in later slices.
model Heartbeat {
  id        String   @id @default(cuid())
  source    String
  createdAt DateTime @default(now())
}

model Customer {
  id                   String                @id @default(cuid())
  slug                 String                @unique
  name                 String
  createdAt            DateTime              @default(now())
  users                User[]
  exams                Exam[]
  examAttempts         ExamAttempt[]
  cloudShareConnection CloudShareConnection?
}

model User {
  id           String          @id @default(cuid())
  customerId   String
  email        String          @unique
  firstName    String?
  lastName     String?
  passwordHash String
  role         String
  createdAt    DateTime        @default(now())
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessions     PortalSession[]
}

model PortalSession {
  id        String   @id
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CloudShareConnection {
  id                      String    @id @default(cuid())
  customerId              String    @unique
  apiIdCiphertext         String
  apiKeyCiphertext        String
  webhookSecretCiphertext String
  webhookPathToken        String    @unique
  connectedAt             DateTime  @default(now())
  verifiedAt              DateTime?
  updatedAt               DateTime  @updatedAt
  customer                Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Exam {
  id                    String   @id
  customerId            String
  title                 String
  description           String
  timeLimitMinutes      Int
  scoreRetrievalEnabled Boolean
  status                String
  publishedAt           DateTime?
  createdAt             DateTime
  updatedAt             DateTime
  projectId             String
  projectName           String
  blueprintId           String
  blueprintName         String
  snapshotId            String
  snapshotName          String
  allowedRegionsJson    String
  policyId              String
  policyName            String
  instructorId          String
  instructorName        String
  customer              Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  attempts              ExamAttempt[]

  @@index([customerId, status])
}

model ExamAttempt {
  id          String     @id
  customerId  String
  candidateId String
  examId      String
  status      String
  scheduledFor DateTime?
  createdAt   DateTime
  updatedAt   DateTime   @updatedAt
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  exam        Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  labLaunch   LabLaunch?
  examClock   ExamClock?

  @@index([candidateId, createdAt])
  @@index([examId, createdAt])
  @@index([customerId, candidateId])
}

model LabLaunch {
  id                    String      @id
  examAttemptId         String      @unique
  candidateId           String
  participantEmail      String?
  participantId         String?
  trainingId            String?
  experienceId          String
  environmentExternalId String?
  environmentId         String?
  loginUrl              String
  status                String
  createdAt             DateTime
  updatedAt             DateTime    @updatedAt
  examAttempt           ExamAttempt @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt])
  @@index([trainingId])
  @@index([environmentExternalId])
}

model ExamClock {
  examAttemptId     String      @id
  status            String
  elapsedAtPauseMs  Int
  startedAt         DateTime?
  updatedAt         DateTime
  examAttempt       ExamAttempt @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
}

model EnvironmentRecord {
  environmentExternalId String   @id
  status                String
  observedAt            DateTime
}

model SupportLogEntry {
  id        String   @id @default(cuid())
  timestamp DateTime
  level     String
  message   String
  fieldsJson String

  @@index([timestamp])
}
