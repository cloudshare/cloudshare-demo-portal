// CloudShare Demo Portal — persistence schema.
// SQLite for the demo; provider is swappable to PostgreSQL for the cloud future.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Walking-skeleton tracer entity: proves the persistence seam round-trips.
// Real domain entities (Candidate, ExamAttempt, ...) arrive in later slices.
model Heartbeat {
  id        String   @id @default(cuid())
  source    String
  createdAt DateTime @default(now())
}

model Customer {
  id                   String                @id @default(cuid())
  slug                 String                @unique
  name                 String
  createdAt            DateTime              @default(now())
  users                User[]
  exams                Exam[]
  examAttempts         ExamAttempt[]
  cloudShareConnection CloudShareConnection?
}

model User {
  id           String          @id @default(cuid())
  customerId   String
  email        String          @unique
  firstName    String?
  lastName     String?
  passwordHash String
  role         String
  createdAt    DateTime        @default(now())
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessions     PortalSession[]
}

model PortalSession {
  id        String   @id
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CloudShareConnection {
  id                      String    @id @default(cuid())
  customerId              String    @unique
  apiIdCiphertext         String
  apiKeyCiphertext        String
  webhookSecretCiphertext String
  webhookPathToken        String    @unique
  connectedAt             DateTime  @default(now())
  verifiedAt              DateTime?
  updatedAt               DateTime  @updatedAt
  customer                Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Exam {
  id                    String   @id
  customerId            String
  title                 String
  description           String
  timeLimitMinutes      Int
  storageLeaseMinutes   Int?
  openPeriodMinutes     Int
  scoreRetrievalEnabled Boolean
  status                String
  publishedAt           DateTime?
  createdAt             DateTime
  updatedAt             DateTime
  projectId             String
  projectName           String
  blueprintId           String
  blueprintName         String
  snapshotId            String
  snapshotName          String
  allowedRegionsJson    String
  policyId              String
  policyName            String
  instructorId          String
  instructorName        String
  customer              Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  attempts              ExamAttempt[]

  @@index([customerId, status])
}

model ExamAttempt {
  id          String     @id
  customerId  String
  candidateId String
  examId      String
  status      String
  scheduledFor DateTime?
  createdAt   DateTime
  updatedAt   DateTime   @updatedAt
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  exam        Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  labLaunch   LabLaunch?
  examClock   ExamClock?

  @@index([candidateId, createdAt])
  @@index([examId, createdAt])
  @@index([customerId, candidateId])
}

model LabLaunch {
  id                    String      @id
  examAttemptId         String      @unique
  candidateId           String
  participantEmail      String?
  participantId         String?
  trainingId            String?
  experienceId          String
  environmentExternalId String?
  environmentId         String?
  loginUrl              String
  status                String
  createdAt             DateTime
  updatedAt             DateTime    @updatedAt
  examAttempt           ExamAttempt @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt])
  @@index([trainingId])
  @@index([environmentExternalId])
}

model ExamClock {
  examAttemptId     String      @id
  status            String
  elapsedAtPauseMs  Int
  startedAt         DateTime?
  updatedAt         DateTime
  examAttempt       ExamAttempt @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
}

model EnvironmentRecord {
  environmentExternalId String   @id
  status                String
  observedAt            DateTime
}

// Typed, append-only support source of truth (ADR-004). Core correlation fields
// are first-class columns so the Support read API filters on them directly and
// never depends on brittle JSON-string search; only free-form structures are
// JSON-encoded. Rows are append-only evidence — no update path is exposed.
model DiagnosticLogEntry {
  id              String   @id @default(cuid())
  occurredAt      DateTime
  level           String
  source          String
  operation       String
  outcome         String
  customerId      String?
  actorType       String?
  actorId         String?
  actorEmail      String?
  subjectType     String?
  subjectId       String?
  message         String
  correlationId   String?
  candidateEmail  String?
  examId          String?
  examAttemptId   String?
  externalIdsJson String?
  requestJson     String?
  responseJson    String?
  detailsJson     String?
  createdAt       DateTime @default(now())

  @@index([customerId, occurredAt])
  @@index([examAttemptId])
  @@index([candidateEmail])
  @@index([correlationId])
}
