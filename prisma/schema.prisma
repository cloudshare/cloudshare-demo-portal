// CloudShare Demo Portal — persistence schema.
// SQLite for the demo; provider is swappable to PostgreSQL for the cloud future.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Walking-skeleton tracer entity: proves the persistence seam round-trips.
// Real domain entities (Candidate, ExamAttempt, ...) arrive in later slices.
model Heartbeat {
  id        String   @id @default(cuid())
  source    String
  createdAt DateTime @default(now())
}

model Customer {
  id                   String                @id @default(cuid())
  slug                 String                @unique
  name                 String
  workspace            String                @default("certification")
  createdAt            DateTime              @default(now())
  users                User[]
  exams                Exam[]
  items                Item[]
  examAttempts         ExamAttempt[]
  cloudShareConnection CloudShareConnection?
  salesAccounts        SalesAccount[]
  salesOpportunities   SalesOpportunity[]
  opportunityContacts  OpportunityContact[]
  salesDemoSessions    SalesDemoSession[]
  invitationCommands   SalesParticipantInvitationCommand[]
  launchOperations     SalesParticipantLaunchOperation[]
  salesTrialOfferings  SalesTrialOffering[]
  salesTrialEnrollments SalesTrialEnrollment[]
  salesTimezoneCache   SalesTimezoneCache?
  salesTrialPortalConfiguration SalesTrialPortalConfiguration?
  salesSessionNameTemplate String @default("{account} - {opportunity} ({revision}) - {item}")
}

model SalesAccount {
  id         String   @id
  customerId String
  name       String
  kind       String
  archivedAt DateTime?
  createdAt  DateTime
  updatedAt  DateTime
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunities SalesOpportunity[]

  @@index([customerId, updatedAt])
  @@unique([customerId, id])
}

model SalesOpportunity {
  id         String   @id
  customerId String
  accountId  String
  name       String
  status     String
  archivedAt DateTime?
  createdAt  DateTime
  updatedAt  DateTime
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  account    SalesAccount @relation(fields: [customerId, accountId], references: [customerId, id], onDelete: Restrict)
  contacts   OpportunityContact[]
  demoSessions SalesDemoSession[]

  @@index([customerId, accountId, updatedAt])
  @@unique([customerId, id])
}

model OpportunityContact {
  id            String   @id
  customerId    String
  opportunityId String
  firstName     String
  lastName      String
  email         String
  normalizedEmail String   @default("")
  source        String   @default("relationship")
  syncStatus    String   @default("not_applicable")
  sourceSessionId String?
  archivedAt    DateTime?
  createdAt     DateTime
  updatedAt     DateTime
  customer      Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunity   SalesOpportunity @relation(fields: [customerId, opportunityId], references: [customerId, id], onDelete: Restrict)
  salesSessionParticipants SalesSessionParticipant[]

  @@index([customerId, opportunityId, updatedAt])
  @@index([customerId, opportunityId, normalizedEmail])
  @@unique([customerId, id])
}

// A Sales-owned, archive-only reusable CloudShare delivery template.  Resource
// identifiers are selected from live per-Customer reads and are never a manual
// authoring field.
model Item {
  id                     String   @id
  customerId             String
  name                   String
  description            String
  projectId              String
  projectName            String
  blueprintsJson         String
  policyId               String
  policyName             String
  regionsJson            String
  defaultDurationMinutes Int
  status                 String
  archivedAt             DateTime?
  createdAt              DateTime
  updatedAt              DateTime
  customer               Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  demoSessions           SalesDemoSession[]
  trialOfferings         SalesTrialOffering[]

  @@index([customerId, status])
  @@unique([customerId, id])
}

model SalesTrialOffering {
  id                          String   @id
  customerId                  String
  itemId                      String
  title                       String
  description                 String
  cloudShareSalesExperienceId String?
  externalId                  String?
  start                       String
  end                         String?
  timeZone                    String
  salesProEmail               String
  salesProDisplayName         String?
  status                      String
  attentionReason             String?
  endingCalculatedEnd         String?
  endingLastReconciledAt      DateTime?
  endingTerminalTarget        String?
  endingLeaseToken            String?
  endingLeaseExpiresAt        DateTime?
  createdAt                   DateTime
  updatedAt                   DateTime
  publishedAt                 DateTime?
  unpublishedAt               DateTime?
  customer                    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  item                        Item     @relation(fields: [customerId, itemId], references: [customerId, id], onDelete: Restrict)
  enrollments                 SalesTrialEnrollment[]

  @@unique([customerId, id])
  @@index([customerId, status, createdAt])
  @@index([customerId, itemId])
}

model SalesTrialEnrollment {
  id                                 String   @id
  customerId                         String
  salesTrialOfferingId               String
  portalUserId                       String
  email                              String
  firstName                          String
  lastName                           String
  cloudShareParticipantId            String?
  invitationStatus                   String   @default("notSent")
  participationStatus                String   @default("pending")
  cloudShareRosterEnvironmentReference String?
  environmentStatus                  String?
  observedExpirationTime             String?
  firstJoined                        String?
  status                             String
  attentionReason                    String?
  lastLaunchedAt                     DateTime?
  lastReconciledAt                   DateTime
  createdAt                          DateTime
  updatedAt                          DateTime
  customer                           Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  offering                           SalesTrialOffering @relation(fields: [customerId, salesTrialOfferingId], references: [customerId, id], onDelete: Cascade)
  user                               User               @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@unique([customerId, salesTrialOfferingId, portalUserId])
  @@unique([cloudShareParticipantId])
  @@index([customerId, salesTrialOfferingId, updatedAt])
}

// Immutable portal-to-CloudShare correlation. Sales Experiences are never
// deleted by Certalis; this record preserves commercial delivery history.
model SalesDemoSession {
  id                          String   @id
  customerId                  String
  opportunityId               String
  itemId                      String
  cloudShareSalesExperienceId String   @unique
  externalId                  String
  type                        String
  start                       String
  end                         String
  timeZone                    String
  salesProEmail               String
  salesProDisplayName         String
  registrationType            String
  sendInvitations             String
  sessionName                 String   @default("")
  revision                    Int      @default(1)
  operationalStatus           String   @default("active")
  attentionReason             String?
  experienceStatus            String?
  experienceStatusObservedAt  DateTime?
  experienceStatusSource      String?
  createdAt                   DateTime
  customer                    Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunity                 SalesOpportunity @relation(fields: [customerId, opportunityId], references: [customerId, id], onDelete: Restrict)
  item                        Item             @relation(fields: [customerId, itemId], references: [customerId, id], onDelete: Restrict)
  participants                SalesSessionParticipant[]
  invitationCommands          SalesParticipantInvitationCommand[]
  launchOperations            SalesParticipantLaunchOperation[]

  @@index([customerId, opportunityId, createdAt])
  @@unique([customerId, id])
  @@unique([customerId, opportunityId, revision])
  @@index([customerId, itemId])
  @@index([customerId, externalId])
}

/// Durable Certalis correlation for a named Opportunity Contact admitted to a
/// Sales Experience. Invite and monitoring fields are reconciled from
/// CloudShare; no invitation URL is retained.
model SalesSessionParticipant {
  id                          String   @id
  customerId                  String
  salesDemoSessionId          String
  opportunityContactId        String
  cloudShareParticipantId     String   @unique
  invitationStatus            String
  lastInvitedAt               DateTime?
  invitedBy                   String?
  participationStatus         String
  firstJoined                 String?
  /// Server-only numeric v4 Sales-roster reference. This is not a v3 Environment ID.
  cloudShareRosterEnvironmentReference String?
  environmentStatus           String?
  environmentStatusCode       Int?
  environmentObservedAt       DateTime?
  environmentAttentionReason  String?
  environmentAttentionSource  String?
  lastReconciledAt            DateTime
  createdAt                   DateTime
  updatedAt                   DateTime
  session                     SalesDemoSession @relation(fields: [customerId, salesDemoSessionId], references: [customerId, id], onDelete: Cascade)
  contact                     OpportunityContact @relation(fields: [customerId, opportunityContactId], references: [customerId, id], onDelete: Restrict)
  launchLinks                 SalesParticipantLaunchLink[]
  invitationTargets            SalesParticipantInvitationTarget[]
  invitationFences             SalesParticipantInvitationFence[]
  launchOperations            SalesParticipantLaunchOperation[]

  @@unique([customerId, salesDemoSessionId, opportunityContactId])
  @@unique([customerId, id])
  @@index([customerId, salesDemoSessionId, updatedAt])
}

/// Opaque public launch capability. Only a SHA-256 digest is persisted; the
/// browser-visible plaintext exists once, in the Sales Admin copy response.
model SalesParticipantLaunchLink {
  id                    String @id
  customerId            String
  salesDemoSessionId    String
  salesSessionParticipantId String
  tokenHash             String @unique
  revokedAt             DateTime?
  createdAt             DateTime
  participant           SalesSessionParticipant @relation(fields: [salesSessionParticipantId], references: [id], onDelete: Cascade)

  @@index([customerId, salesDemoSessionId, salesSessionParticipantId])
}

model SalesParticipantInvitationCommand {
  customerId String
  commandId String
  sessionId String
  scopeHash String
  phase String
  revision Int @default(1)
  admissionTokenHash String?
  admissionLeaseUntil DateTime?
  correlationId String?
  httpStatus Int?
  resultCode String?
  createdAt DateTime
  updatedAt DateTime
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  session SalesDemoSession @relation(fields: [customerId, sessionId], references: [customerId, id], onDelete: Cascade)
  targets SalesParticipantInvitationTarget[]
  fences SalesParticipantInvitationFence[]
  @@id([customerId, commandId])
}

/// Durable at-most-once fence for canonical Participant registration.
model SalesParticipantAddCommand {
  customerId       String
  commandId        String
  sessionId        String
  targetKey        String   @default("")
  payloadHash      String
  state            String
  status           Int?
  resultJson       String?
  correlationId    String?
  createdAt        DateTime
  updatedAt        DateTime
  @@id([customerId, commandId])
  @@unique([customerId, sessionId, commandId])
  @@index([customerId, sessionId, createdAt])
  @@unique([customerId, sessionId, targetKey])
}

/// Safe, non-secret outcome history for admin participant launch actions.
model SalesParticipantLaunchOperation {
  id                       String   @id
  customerId               String
  salesDemoSessionId       String
  salesSessionParticipantId String
  correlationId            String
  operation                String
  outcome                  String
  safeReason               String?
  occurredAt               DateTime
  revision                 Int
  customer                 Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  session                  SalesDemoSession @relation(fields: [customerId, salesDemoSessionId], references: [customerId, id], onDelete: Cascade)
  participant              SalesSessionParticipant @relation(fields: [customerId, salesSessionParticipantId], references: [customerId, id], onDelete: Cascade)
  @@index([customerId, salesDemoSessionId, salesSessionParticipantId, occurredAt])
  @@index([customerId, salesDemoSessionId, occurredAt])
}

model SalesParticipantInvitationTarget {
  customerId String
  commandId String
  salesSessionParticipantId String
  ordinal Int
  intent String
  expectedInvitationStatus String
  participantRevision String
  projectionRevision String @default("")
  outcome String?
  reason String?
  command SalesParticipantInvitationCommand @relation(fields: [customerId, commandId], references: [customerId, commandId], onDelete: Cascade)
  participant SalesSessionParticipant @relation(fields: [customerId, salesSessionParticipantId], references: [customerId, id], onDelete: Cascade)
  @@id([customerId, commandId, salesSessionParticipantId])
  @@unique([customerId, commandId, ordinal])
}

model SalesParticipantInvitationFence {
  customerId String
  salesSessionParticipantId String
  commandId String
  revision Int @default(1)
  acquiredAt DateTime
  command SalesParticipantInvitationCommand @relation(fields: [customerId, commandId], references: [customerId, commandId], onDelete: Cascade)
  participant SalesSessionParticipant @relation(fields: [customerId, salesSessionParticipantId], references: [customerId, id], onDelete: Cascade)
  @@id([customerId, salesSessionParticipantId])
}

model User {
  id           String          @id @default(cuid())
  customerId   String
  email        String          @unique
  firstName    String?
  lastName     String?
  passwordHash String
  role         String
  createdAt    DateTime        @default(now())
  lastSalesTimeZone String?
  lastSalesExperienceType String?
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessions     PortalSession[]
  salesTrialEnrollments SalesTrialEnrollment[]

}

/// Explicitly enables one Customer-owned Sales Trial participant portal. This
/// anchors self-registration without making workspace routing a trial selector.
model SalesTrialPortalConfiguration {
  customerId          String   @id
  registrationEnabled Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  customer            Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

/** Per-Customer cache of the documented v3 timezone catalogue. It is a cache,
 * never a source of truth: the reader records freshness and can report a
 * fallback instead of silently inventing timezones. */
model SalesTimezoneCache {
  customerId String @id
  valuesJson String
  fetchedAt DateTime
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model PortalSession {
  id        String   @id
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CloudShareConnection {
  id                      String    @id @default(cuid())
  customerId              String    @unique
  apiIdCiphertext         String
  apiKeyCiphertext        String
  webhookSecretCiphertext String
  webhookPathToken        String    @unique
  connectedAt             DateTime  @default(now())
  verifiedAt              DateTime?
  updatedAt               DateTime  @updatedAt
  customer                Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Exam {
  id                    String   @id
  customerId            String
  title                 String
  description           String
  timeLimitMinutes      Int
  storageLeaseMinutes   Int?
  openPeriodMinutes     Int
  scoreRetrievalEnabled Boolean
  status                String
  publishedAt           DateTime?
  archivedAt            DateTime?
  createdAt             DateTime
  updatedAt             DateTime
  projectId             String
  projectName           String
  blueprintId           String
  blueprintName         String
  snapshotId            String
  snapshotName          String
  allowedRegionsJson    String
  policyId              String
  policyName            String
  instructorId          String
  instructorName        String
  customer              Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  attempts              ExamAttempt[]
  deliveryAvailability  String   @default("individual")
  cohortSessions        CohortExamSession[]

  @@index([customerId, status])
}

model CohortExamSession {
  id                 String   @id
  customerId         String
  examId             String
  name               String
  admissionStartsAt  DateTime
  admissionEndsAt    DateTime?
  capacity           Int?
  status             String
  cloudShareTrainingId  String?
  cloudShareExperienceId String?
  cloudShareTeamId      String?
  publishedAt        DateTime?
  admissionClosedAt  DateTime?
  retiredAt          DateTime?
  lastPublishError   String?
  lastPublishCorrelationId String?
  createdAt          DateTime
  updatedAt          DateTime
  exam               Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([customerId, examId, status])
  @@index([examId, createdAt])
  @@index([cloudShareTrainingId])
}

model CohortMonitoringObservation {
  id              String   @id @default(cuid())
  customerId      String
  cohortSessionId String
  rowKey          String
  signature       String
  consecutiveReads Int      @default(1)
  observedAt      DateTime

  @@unique([customerId, cohortSessionId, rowKey])
  @@index([cohortSessionId, observedAt])
}

model ExamAttempt {
  id          String     @id
  customerId  String
  candidateId String
  examId      String
  cohortSessionId String?
  status      String
  scheduledFor DateTime?
  createdAt   DateTime
  updatedAt   DateTime   @updatedAt
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  exam        Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  labLaunch   LabLaunch?
  examClock   ExamClock?

  @@index([candidateId, createdAt])
  @@index([examId, createdAt])
  @@index([customerId, candidateId])
  @@index([cohortSessionId, createdAt])
  @@unique([candidateId, cohortSessionId])
}

model ExamAttemptAdmissionLock {
  id          String   @id @default(cuid())
  candidateId String
  examId      String
  acquiredAt  DateTime @default(now())

  @@unique([candidateId, examId])
}

model LabLaunch {
  id                    String      @id
  examAttemptId         String      @unique
  candidateId           String
  participantEmail      String?
  participantId         String?
  trainingId            String?
  experienceId          String
  environmentExternalId String?
  environmentId         String?
  loginUrl              String
  status                String
  createdAt             DateTime
  updatedAt             DateTime    @updatedAt
  examAttempt           ExamAttempt @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt])
  @@index([trainingId])
  @@index([environmentExternalId])
}

model ExamClock {
  examAttemptId     String      @id
  status            String
  elapsedAtPauseMs  Int
  startedAt         DateTime?
  updatedAt         DateTime
  examAttempt       ExamAttempt @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
}

model EnvironmentRecord {
  environmentExternalId String   @id
  status                String
  observedAt            DateTime
}

// Typed, append-only support source of truth (ADR-004). Core correlation fields
// are first-class columns so the Support read API filters on them directly and
// never depends on brittle JSON-string search; only free-form structures are
// JSON-encoded. Rows are append-only evidence — no update path is exposed.
model DiagnosticLogEntry {
  id              String   @id @default(cuid())
  occurredAt      DateTime
  level           String
  source          String
  operation       String
  outcome         String
  customerId      String?
  actorType       String?
  actorId         String?
  actorEmail      String?
  subjectType     String?
  subjectId       String?
  message         String
  correlationId   String?
  candidateEmail  String?
  examId          String?
  examAttemptId   String?
  externalIdsJson String?
  requestJson     String?
  responseJson    String?
  detailsJson     String?
  createdAt       DateTime @default(now())

  @@index([customerId, occurredAt])
  @@index([examAttemptId])
  @@index([candidateEmail])
  @@index([correlationId])
}

// Append-only administrative audit trail. Audit answers who attempted to change
// portal state, what subject was affected, and whether the action succeeded,
// failed, or was denied. It is intentionally separate from DiagnosticLogEntry.
model AuditTrailEntry {
  id             String   @id
  occurredAt     DateTime
  customerId     String?
  actorType      String?
  actorId        String?
  actorEmail     String?
  action         String
  subjectType    String?
  subjectId      String?
  outcome        String
  candidateId    String?
  candidateEmail String?
  examId         String?
  examAttemptId  String?
  correlationId  String?
  detailsJson    String?
  error          String?
  createdAt      DateTime @default(now())

  @@index([customerId, occurredAt])
  @@index([examAttemptId])
  @@index([examId])
  @@index([candidateEmail])
  @@index([actorEmail])
  @@index([subjectType, subjectId])
  @@index([correlationId])
}
