# CloudShare live E2E credentials.
# Copy to `.env.e2e.local` and fill locally. `.env*.local` is ignored by git.
# These credentials are used only by `npm run test:e2e:live`; normal `npm test`
# excludes live E2E tests.

CLOUDSHARE_E2E_API_ID=
CLOUDSHARE_E2E_API_KEY=

# Optional for tests that need to exercise webhook verification later. The
# current live ping E2E test does not send this to CloudShare.
CLOUDSHARE_E2E_WEBHOOK_SECRET=local-e2e-webhook-secret
