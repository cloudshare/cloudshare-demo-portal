# CloudShare Demo Portal — environment configuration.
# Copy to `.env` and fill in real values. Commit ONLY this example (placeholders).
# Config is Zod-validated at boot; the app fails fast if anything required is missing.

# ─── Category 1: Secrets (env-only, redacted in logs) ───────────────────────
# Portal master key used to encrypt stored CloudShare credentials at rest.
# This example value is a valid base64-encoded 32-byte key for local fixture use.
# Generate your own for any real environment. Example:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
PORTAL_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Legacy global CloudShare creds are tolerated for unfinished slices, but Slice 1
# stores the real CloudShare Connection per-Customer in the database instead.
CLOUDSHARE_V4_CLIENT_ID=
CLOUDSHARE_V4_CLIENT_SECRET=
CLOUDSHARE_V3_API_ID=
CLOUDSHARE_V3_API_KEY=
CLOUDSHARE_WEBHOOK_SECRET=

# ─── Category 2: Runtime flags ──────────────────────────────────────────────
# "live" makes real CloudShare API calls; "fixture" replays recorded responses.
PORTAL_MODE=fixture
# Public tunnel URL CloudShare webhooks post to in live mode (e.g. ngrok). Optional in fixture mode.
PORTAL_TUNNEL_URL=
# Seconds without a client heartbeat before the server auto-suspends the lab (default: 60000 ms = 60 s).
HEARTBEAT_TIMEOUT_MS=60000
# Seed source for the Helios admin demo tenant: `off`, `env`, or `file`.
PORTAL_SEED_SOURCE=file
# Used only when `PORTAL_SEED_SOURCE=file`.
PORTAL_SEED_CONFIG_PATH=./config/portal-seed.local.json

# ─── Optional env-based seed source (used only when PORTAL_SEED_SOURCE=env) ──
HELIOS_ADMIN_EMAIL=
HELIOS_ADMIN_PASSWORD=
HELIOS_SEED_CLOUDSHARE_API_ID=
HELIOS_SEED_CLOUDSHARE_API_KEY=
HELIOS_SEED_CLOUDSHARE_WEBHOOK_SECRET=
HELIOS_SEED_CLOUDSHARE_INSTRUCTOR_ID=
HELIOS_SEED_CLOUDSHARE_INSTRUCTOR_NAME=

# ─── Persistence ────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"
